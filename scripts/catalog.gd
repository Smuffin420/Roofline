static func all() -> Array:
	return MAPS


static func challenges() -> Array:
	return CHALLENGES


static func ids() -> Array:
	var out: Array = []
	for map in MAPS:
		out.append(map["id"])
	return out


static func get_map(id: String) -> Dictionary:
	for map in MAPS:
		if str(map["id"]) == id:
			return map
	for map in CHALLENGES:
		if str(map["id"]) == id:
			return map
	return MAPS[0]


static func meters_for(map: Dictionary) -> int:
	return int(round(float(map["minutes"]) * 60.0 * PACE))


static func about(map: Dictionary) -> String:
	var minutes := float(map["minutes"])
	if absf(minutes - round(minutes)) < 0.05:
		return "About %d min" % int(round(minutes))
	var tenths := int(round(minutes * 10.0))
	return "About %d.%d min" % [int(tenths / 10), tenths % 10]
